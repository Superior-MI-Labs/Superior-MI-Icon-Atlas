{
  "schema": "smi-visual-scenarios/1",
  "description": "Request-specific browser rendering gates. Every test uses actual builder Canvas pixels, not schema-only assertions.",
  "cases": [
    {
      "id": "hud-meter-range",
      "pack": "interactive-hud.zip",
      "preview_name": "Interactive energy meter",
      "samples": [
        {
          "id": "empty",
          "inputs": {
            "value": 0
          }
        },
        {
          "id": "half",
          "inputs": {
            "value": 50
          }
        },
        {
          "id": "full",
          "inputs": {
            "value": 100
          }
        }
      ],
      "assertions": [
        {
          "type": "green_increases",
          "samples": [
            "empty",
            "half",
            "full"
          ],
          "min_step": 500
        },
        {
          "type": "output_equals",
          "sample": "half",
          "field": "value",
          "equals": 50
        },
        {
          "type": "different",
          "a": "empty",
          "b": "full",
          "min_changed_pixels": 1000
        }
      ]
    },
    {
      "id": "character-states-and-walk",
      "pack": "character-animations.zip",
      "preview_name": "Robot animation states",
      "samples": [
        {
          "id": "idle",
          "state": "idle",
          "time_ms": 0
        },
        {
          "id": "walk-start",
          "state": "walk",
          "time_ms": 0
        },
        {
          "id": "walk-next",
          "state": "walk",
          "time_ms": 140
        },
        {
          "id": "walk-loop",
          "state": "walk",
          "time_ms": 500
        }
      ],
      "assertions": [
        {
          "type": "different",
          "a": "idle",
          "b": "walk-start",
          "min_changed_pixels": 20
        },
        {
          "type": "different",
          "a": "walk-start",
          "b": "walk-next",
          "min_changed_pixels": 20
        },
        {
          "type": "same",
          "a": "walk-start",
          "b": "walk-loop",
          "max_changed_pixels": 0
        }
      ]
    },
