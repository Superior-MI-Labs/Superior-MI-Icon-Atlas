{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superior-MI-Labs/Superior-MI-Icon-Atlas/blob/design/visual-atlas-r0/proposals/visual-atlas-r0/schema.json",
  "title": "Superior MI Visual Atlas proposal: pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "version",
    "textures",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "smi-visual-pack/1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "textures": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/texture"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "width_px",
        "height_px"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "enum": [
            "straight",
            "premultiplied",
            "none"
          ]
        },
        "color_space": {
          "enum": [
            "srgb",
            "linear"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "offset_px": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "equals"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "axis",
        "origin"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "origin": {
          "enum": [
            "start",
            "end"
          ]
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "offset_px": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blend": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add"
          ]
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        },
        "state_from_input": {
          "type": "string",
          "minLength": 1
        },
        "clip": {
          "$ref": "#/$defs/clip"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        },
        "position_from_input": {
          "$ref": "#/$defs/positionBinding"
        },
        "input_values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "size_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "number",
            "enum"
          ]
        },
        "default": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "region",
            "sequence",
            "composition",
            "state_set"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "texture": {
          "type": "string",
          "minLength": 1
        },
        "rect_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "logical_size_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "trim_offset_px": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "nine_slice_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "default_fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "playback": {
          "enum": [
            "once",
            "loop",
            "pingpong"
          ]
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "size_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "minItems": 1
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "region"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "texture",
              "rect_px"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "default_fps",
              "frames",
              "playback"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "composition"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "layers",
              "size_px"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "state_set"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "states",
              "default_state"
            ]
          }
        }
      ]
    },
    "positionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "axis",
        "from_px",
        "to_px"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "from_px": {
          "type": "number"
        },
        "to_px": {
          "type": "number"
        }
      }
    }
  }
}
