  "license": "CC0-1.0",
  "textures": {
    "atlas": {
      "path": "textures/atlas.png",
      "width_px": 384,
      "height_px": 192,
      "alpha": "straight"
    }
  },
  "assets": [
    {
      "id": "smi.example.robot.idle.frame1",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        0,
        0,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.idle.frame2",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        96,
        0,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.idle.frame3",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        192,
        0,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.idle.frame4",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        288,
        0,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.walk.frame1",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        0,
        96,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.walk.frame2",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        96,
        96,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.walk.frame3",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        192,
        96,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.walk.frame4",
      "kind": "region",
      "texture": "atlas",
      "rect_px": [
        288,
        96,
        96,
        96
      ]
    },
    {
      "id": "smi.example.robot.idle",
      "kind": "sequence",
      "name": "Idle animation",
      "default_fps": 4,
      "playback": "loop",
      "tags": [
        "robot",
        "character",
        "sprite",
        "animation",
        "idle"
      ],
      "frames": [
        {
          "asset": "smi.example.robot.idle.frame1"
        },
        {
          "asset": "smi.example.robot.idle.frame2"
        },
        {
          "asset": "smi.example.robot.idle.frame3"
        },
        {
          "asset": "smi.example.robot.idle.frame4"
        }
      ]
    },
    {
      "id": "smi.example.robot.walk",
      "kind": "sequence",
      "name": "Walk animation",
      "default_fps": 8,
      "playback": "loop",
      "tags": [
        "robot",
        "character",
        "sprite",
        "animation",
        "walk"
      ],
      "frames": [
        {
          "asset": "smi.example.robot.walk.frame1"
        },
        {
          "asset": "smi.example.robot.walk.frame2"
        },
        {
          "asset": "smi.example.robot.walk.frame3"
        },
        {
          "asset": "smi.example.robot.walk.frame4"
        }
      ]
    },
    {
      "id": "smi.example.robot.states",
      "kind": "state_set",
      "name": "Robot animation states",
      "default_state": "idle",
      "states": {
        "idle": "smi.example.robot.idle",
        "walk": "smi.example.robot.walk"
      },
      "tags": [
        "robot",
        "stateful",
        "idle",
        "walk"
      ]
    },
    {
      "id": "smi.example.robot.actor",
      "kind": "composition",
      "name": "Robot stat action preview",
      "size_px": [
        128,
        128
      ],
      "tags": [
        "robot",
        "animation",
        "statistics",
        "interactive",
        "demo"
      ],
      "inputs": {
        "animation": {
          "type": "enum",
          "default": "idle",
          "values": [
            "idle",
            "walk"
          ]
        },
        "stamina": {
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 60
        }
      },
      "behavior": {
        "role": "actor",
        "outputs": {
          "stamina": {
            "from_input": "stamina"
          }
        },
        "on": {
          "dash": [
            {
              "op": "set",
              "input": "animation",
              "value": "walk"
            }
          ],
          "recover": [
            {
              "op": "set",
              "input": "animation",
              "value": "idle"
            }
          ]
        }
      },
      "layers": [
        {
          "id": "robot",
          "asset": "smi.example.robot.states",
          "state_from_input": "animation"
        }
      ]
    }
  ],
  "preview_profiles": [
    {
      "schema": "smi-preview-controls/1",
      "id": "smi.example.robot.platformer",
      "name": "Platformer controls",
      "asset": "smi.example.robot.states",
      "neutral": {
        "state": "idle"
      },
      "actions": {
        "move": {
          "mode": "hold",
          "target": {
            "state": "walk"
          }
        }
      },
      "bindings": [
        {
          "device": "keyboard",
          "code": "ArrowRight",
          "action": "move"
        },
        {
          "device": "gamepad_button",
          "button": 15,
          "action": "move"
        }
      ]
    },
    {
      "schema": "smi-preview-controls/1",
      "id": "smi.example.robot.alternative",
      "name": "Alternative keyboard controls",
      "asset": "smi.example.robot.states",
      "neutral": {
        "state": "idle"
      },
      "actions": {
        "move": {
          "mode": "hold",
          "target": {
            "state": "walk"
          }
        }
      },
      "bindings": [
        {
          "device": "keyboard",
          "code": "KeyW",
          "action": "move"
        },
        {
          "device": "gamepad_button",
          "button": 12,
          "action": "move"
        }
      ]
    }
  ],
  "stat_profiles": [
    {
      "schema": "smi-stat-profile/1",
      "id": "smi.example.robot.stamina-lab",
      "name": "Robot stamina & animation",
      "asset": "smi.example.robot.actor",
      "stats": {
        "stamina": {
          "initial": 60,
          "min": 0,
          "max": 100
        },
        "speed": {
          "initial": 4,
          "min": 1,
          "max": 10
        }
      },
      "actions": {
        "dash": {
          "costs": {
            "stamina": 20
          },
          "emit": "dash"
        },
        "recover": {
          "deltas": {
            "stamina": 25
          },
          "emit": "recover"
        }
      },
      "bindings": [
        {
          "stat": "stamina",
          "input": "stamina"
        }
      ]
    }
  ]
}
