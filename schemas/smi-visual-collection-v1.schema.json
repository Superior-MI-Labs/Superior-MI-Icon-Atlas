{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Superior MI Visual Atlas collection index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "collection_id", "name", "packs"],
  "properties": {
    "schema": {"const": "smi-visual-collection/1"},
    "collection_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "entry_asset": {"type": "string", "minLength": 1},
    "packs": {
      "type": "array", "minItems": 1, "maxItems": 96,
      "items": {
        "type": "object", "required": ["manifest"], "additionalProperties": false,
        "properties": {"manifest": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "category": {"type": "string"}}
      }
    }
  }
}
