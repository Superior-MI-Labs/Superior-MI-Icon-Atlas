{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superior-MI-Labs/Superior-MI-Icon-Atlas/blob/main/schemas/smi-visual-pack-v1.schema.json",
  "title": "Superior MI Visual Atlas pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "version",
    "textures",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "smi-visual-pack/1"
    },
    "pack_id": {
      "$ref": "#/$defs/nonblank"
    },
    "version": {
      "$ref": "#/$defs/nonblank"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "textures": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/texture"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1
    },
    "px2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "size2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "margins": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4
    },
    "pivot": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "width_px",
        "height_px"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonblank"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "alpha": {
          "enum": [
            "none",
            "straight",
            "premultiplied"
          ]
        },
        "color_space": {
          "enum": [
            "srgb",
            "linear"
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "equals"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonblank"
        },
        "equals": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "axis",
        "origin"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonblank"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "origin": {
          "enum": [
            "start",
            "end"
          ]
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "axis",
        "from_px",
        "to_px"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonblank"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "from_px": {
          "type": "number"
        },
        "to_px": {
          "type": "number"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "number",
            "enum"
          ]
        },
        "default": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/nonblank"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "offset_px": {
          "$ref": "#/$defs/px2"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "asset": {
          "$ref": "#/$defs/nonblank"
        },
        "offset_px": {
          "$ref": "#/$defs/px2"
        },
        "size_px": {
          "$ref": "#/$defs/size2"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blend": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add"
          ]
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        },
        "clip": {
          "$ref": "#/$defs/clip"
        },
        "position_from_input": {
          "$ref": "#/$defs/position"
        },
        "state_from_input": {
          "$ref": "#/$defs/nonblank"
        },
        "state": {
          "$ref": "#/$defs/nonblank"
        },
        "input_values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "kind": {
          "enum": [
            "region",
            "sequence",
            "composition",
            "state_set"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          },
          "uniqueItems": true
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          },
          "uniqueItems": true
        },
        "texture": {
          "$ref": "#/$defs/nonblank"
        },
        "rect_px": {
          "$ref": "#/$defs/rect"
        },
        "logical_size_px": {
          "$ref": "#/$defs/size2"
        },
        "trim_offset_px": {
          "$ref": "#/$defs/px2"
        },
        "pivot": {
          "$ref": "#/$defs/pivot"
        },
        "nine_slice_px": {
          "$ref": "#/$defs/margins"
        },
        "default_fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "playback": {
          "enum": [
            "once",
            "loop",
            "pingpong"
          ]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "size_px": {
          "$ref": "#/$defs/size2"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "default_state": {
          "$ref": "#/$defs/nonblank"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "region"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "texture",
              "rect_px"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "default_fps",
              "playback",
              "frames"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "composition"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "size_px",
              "layers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "state_set"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "states",
              "default_state"
            ]
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "value"
      ],
      "properties": {
        "time_ms": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "easing": {
          "enum": [
            "linear",
            "step",
            "smooth"
          ]
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "keyframes"
      ],
      "properties": {
        "property": {
          "enum": [
            "x",
            "y",
            "opacity",
            "scale_x",
            "scale_y",
            "rotation_deg"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    }
  }
}
